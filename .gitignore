node_modules/
dist/
apps/desktop/dist/
dist-installer/
.test-build/
.rex/
electron-out.log
electron-err.log
*.tsbuildinfo
.DS_Store
# stray Windows redirect artifact
nul

# server state — users, tokens, session secret
server/data/
server/.env
dist-deploy/
.tunnel-url
.tunnel-key
.tunnel-key.pub

# admin bootstrap password — plaintext, must never be published
.admin-bootstrap.tmp

# captured third-party site bundles (research artifacts, not REX source).
# am/ embeds a third party's live Google Maps API key; publishing it would
# expose someone else's credential.
am/
bundles/

# private backend deploy bundle — must never enter the public site repo
rex-api/

# unified site+API Node app (deploy bundle) — keep out of the public site repo
rex-app/

# --- monorepo: this repository is the WEBSITE only ---
# Nothing below belongs on a public repo, and until now nothing stopped it
# going there: the directories were merely never added, so a single
# `git add -A` published the application source. Naming them is the control.
apps/
packages/
# scripts/* rather than scripts/, because git will not re-include a file whose
# parent directory is excluded — the negation below only works this way round.
scripts/*
# …except the one that maintains this site: it regenerates the inline manifest
# in downloads.html, and a checksum that drifts from the file is the worst
# thing a download page can publish.
!scripts/sync-downloads-html.mjs
!scripts/sync-update-feed.mjs
server/
tests/
build/
.claude/
tsconfig.json
package.json
package-lock.json
ledger-panels.html
.github/workflows/ci.yml
